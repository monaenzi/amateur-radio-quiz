# MySQL
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=amateurfunk_db
 
# Datenbankverbindung — WICHTIG: Host muss "db" sein (Container-Name), NICHT "localhost"!
DATABASE_URL="mysql://root:change_me@db:3306/amateurfunk_db"
 
# NextAuth
NEXTAUTH_SECRET=change_me
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
 
# Cloudinary
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=change_me
 
# SSO
SSO_CLIENT_ID=change_me
SSO_CLIENT_SECRET=change_me
SSO_ISSUER="https://sso.övsv.at"