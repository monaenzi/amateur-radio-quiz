generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int                    @id @default(autoincrement())
  email      String?                @unique
  password   String?
  createdAt  DateTime               @default(now())
  role       Role                   @default(USER)
  name       String?
  callSign   String?
  externalId String?                @unique
  progress   UserQuestionProgress[]

  @@map("users")
}

model Question {
  id          Int                    @id @default(autoincrement())
  text        String                 @db.Text
  explanation String?                @db.Text
  subject     String
  code        String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  answers     Answer[]
  attachments Attachment[]
  classes     QuestionClass[]
  progress    UserQuestionProgress[]

  @@map("questions")
}

model QuestionClass {
  id         Int      @id @default(autoincrement())
  class      Int
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, class])
  @@map("question_classes")
}

model Answer {
  id         Int      @id @default(autoincrement())
  text       String   @db.Text
  isCorrect  Boolean  @default(false)
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId], map: "answers_questionId_fkey")
  @@map("answers")
}

model Attachment {
  id         Int      @id @default(autoincrement())
  url        String
  type       String
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId], map: "attachments_questionId_fkey")
  @@map("attachments")
}

model UserQuestionProgress {
  id         Int        @id @default(autoincrement())
  userId     Int
  questionId Int
  confidence Confidence @default(UNKNOWN)
  updatedAt  DateTime   @updatedAt
  question   Question   @relation(fields: [questionId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([userId, questionId])
  @@index([questionId], map: "user_question_progress_questionId_fkey")
  @@map("user_question_progress")
}

enum Role {
  USER
  ADMIN
}

enum Confidence {
  UNKNOWN
  MEDIUM
  KNOWN
}
